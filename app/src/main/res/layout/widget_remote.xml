<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/w_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingBottom="6dp"
        android:text="Projector"
        android:textColor="#FF8A91A5"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/w_back"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/widget_btn"
            android:src="@drawable/ic_n_back"
            android:tint="#FFF3F5FA"
            android:scaleType="center"
            android:contentDescription="w_back" />
        <ImageButton
            android:id="@+id/w_vol_down"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/widget_btn"
            android:src="@drawable/ic_n_vol_down"
            android:tint="#FFF3F5FA"
            android:scaleType="center"
            android:contentDescription="w_vol_down" />
        <ImageButton
            android:id="@+id/w_play"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/widget_btn_accent"
            android:src="@drawable/ic_n_play"
            android:tint="#FF1B1408"
            android:scaleType="center"
            android:contentDescription="w_play" />
        <ImageButton
            android:id="@+id/w_vol_up"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/widget_btn"
            android:src="@drawable/ic_n_vol_up"
            android:tint="#FFF3F5FA"
            android:scaleType="center"
            android:contentDescription="w_vol_up" />
        <ImageButton
            android:id="@+id/w_home"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/widget_btn"
            android:src="@drawable/ic_n_home"
            android:tint="#FFF3F5FA"
            android:scaleType="center"
            android:contentDescription="w_home" />
    </LinearLayout>
</LinearLayout>
